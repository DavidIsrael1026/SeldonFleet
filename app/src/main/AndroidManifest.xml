<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml - Seldon Fleet
    Atende ao REQ-01: Não declara nenhuma permissão de rede (<uses-permission android:name="android.permission.INTERNET"/>).
    A aplicação é estritamente offline e opera a partir de assets/frota.json.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Seldon Fleet"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Seldon Fleet"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>